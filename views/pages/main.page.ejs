<main class="app-shell">
        
    <div class="content">
        <!-- Header -->
        <header class="header">
            <h1>Geem Music</h1>

            <div class="header-actions">
                <button type="button" class="icon-btn" id="themeToggle" aria-label="Ganti Tema">
                    <img src="assets/icons/sun.svg" class="icon-sun" alt="">
                    <img src="assets/icons/moon.svg" class="icon-moon" alt="">
                </button>

                <button type="button" class="icon-btn" id="settingsBtn" aria-label="Pengaturan">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                </button>
            </div>
        </header>

        <!-- Daftar Lagu -->
        <section class="track-list" aria-label="Daftar Lagu">
            <div class="track-item">
                <div class="track-left">
                    <img src="https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=150&q=80" alt="Message" class="track-thumb">
                    <div class="track-info">
                        <div class="track-name">Message</div>
                        <div class="track-artist">Cameron Rogers</div>
                    </div>
                </div>
                <span class="track-duration">5:32</span>
            </div>

            <div class="track-item">
                <div class="track-left">
                    <img src="https://images.unsplash.com/photo-1557682250-33bd709cbe85?auto=format&fit=crop&w=150&q=80" alt="After you" class="track-thumb">
                    <div class="track-info">
                        <div class="track-name">After you</div>
                        <div class="track-artist">Rafeeda El Nouri</div>
                    </div>
                </div>
                <span class="track-duration">4:12</span>
            </div>

            <div class="track-item">
                <div class="track-left">
                    <img src="https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=150&q=80" alt="Article" class="track-thumb">
                    <div class="track-info">
                        <div class="track-name">Article</div>
                        <div class="track-artist">Ilya Vasin</div>
                    </div>
                </div>
                <span class="track-duration">2:45</span>
            </div>

            <div class="track-item">
                <div class="track-left">
                    <img src="https://images.unsplash.com/photo-1518837695005-2083093ee35b?auto=format&fit=crop&w=150&q=80" alt="Tide Lines" class="track-thumb">
                    <div class="track-info">
                        <div class="track-name">Tide Lines</div>
                        <div class="track-artist">Sora Takahashi</div>
                    </div>
                </div>
                <span class="track-duration">3:58</span>
            </div>

            <div class="track-item">
                <div class="track-left">
                    <img src="https://images.unsplash.com/photo-1579783902614-a3fb3927b6a5?auto=format&fit=crop&w=150&q=80" alt="Golden Hour" class="track-thumb">
                    <div class="track-info">
                        <div class="track-name">Golden Hour</div>
                        <div class="track-artist">Nadia Vance</div>
                    </div>
                </div>
                <span class="track-duration">4:20</span>
            </div>

            <div class="track-item">
                <div class="track-left">
                    <img src="https://images.unsplash.com/photo-1541701494587-cb58502866ab?auto=format&fit=crop&w=150&q=80" alt="Velvet Haze" class="track-thumb">
                    <div class="track-info">
                        <div class="track-name">Velvet Haze</div>
                        <div class="track-artist">Lucas Moreau</div>
                    </div>
                </div>
                <span class="track-duration">3:14</span>
            </div>

            <div class="track-item">
                <div class="track-left">
                    <img src="https://images.unsplash.com/photo-1506744038136-46273834b3fb?auto=format&fit=crop&w=150&q=80" alt="Still Water" class="track-thumb">
                    <div class="track-info">
                        <div class="track-name">Still Water</div>
                        <div class="track-artist">Hana Mizuki</div>
                    </div>
                </div>
                <span class="track-duration">6:05</span>
            </div>

            <div class="track-item">
                <div class="track-left">
                    <img src="https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=150&q=80" alt="Night Drive" class="track-thumb">
                    <div class="track-info">
                        <div class="track-name">Night Drive</div>
                        <div class="track-artist">Kieran Blake</div>
                    </div>
                </div>
                <span class="track-duration">3:49</span>
            </div>

            <div class="track-item">
                <div class="track-left">
                    <img src="https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?auto=format&fit=crop&w=150&q=80" alt="Morning Dew" class="track-thumb">
                    <div class="track-info">
                        <div class="track-name">Morning Dew</div>
                        <div class="track-artist">Alya Pratama</div>
                    </div>
                </div>
                <span class="track-duration">4:03</span>
            </div>

            <div class="track-item">
                <div class="track-left">
                    <img src="https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=150&q=80" alt="Echoes" class="track-thumb">
                    <div class="track-info">
                        <div class="track-name">Echoes</div>
                        <div class="track-artist">Deveedaas Nandi</div>
                    </div>
                </div>
                <span class="track-duration">5:11</span>
            </div>
        </section>
    </div>

    <!-- Bottom Mini Player -->
    <footer class="mini-player glass-surface" id="miniPlayer">
        <button type="button" class="sheet-handle-btn" id="openPlayerTrigger" aria-label="Buka Main Player">
            <span class="sheet-handle"></span>
        </button>

        <div class="player-row">
            <div class="player-left" id="miniPlayerInfo">
                <img
                    src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=150&q=80"
                    alt="Love me"
                    class="player-thumb"
                    id="miniThumb"
                >
                <div class="player-meta">
                    <div class="player-title" id="miniTitle">Love me</div>
                    <div class="player-artist" id="miniArtist">Deveedaas Nandi</div>
                </div>
            </div>

            <div class="player-controls">
                <button type="button" class="control-btn" id="miniPlayBtn" aria-label="Play">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="6 4 20 12 6 20 6 4"/>
                    </svg>
                </button>

                <button type="button" class="control-btn" id="miniNextBtn" aria-label="Next">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="4 5 14 12 4 19 4 5"/>
                        <polygon points="13 5 23 12 13 19 13 5"/>
                    </svg>
                </button>
            </div>
        </div>
    </footer>


























    <!-- Main Player Full-Screen (Frosted Glass + Sudut Luar Kotak) -->
    <section class="main-player glass-surface" id="mainPlayer" aria-hidden="true" aria-label="Main Player">
        <!-- Ambient Glow Halus dari Cover -->
        <div class="mp-ambient" aria-hidden="true">
            <img
                src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=300&q=60"
                alt=""
                class="mp-ambient-img"
                id="mpAmbientImg"
            >
        </div>

        <div class="mp-inner">
            <!-- Handle & Header Bar -->
            <div class="mp-header-zone">
                <button type="button" class="sheet-handle-btn mp-handle-btn" id="closePlayerHandle" aria-label="Tutup Main Player">
                    <span class="sheet-handle"></span>
                </button>

                <div class="mp-topbar">
                    <button type="button" class="mp-nav-btn" id="closePlayerBtn" aria-label="Kembali">
                        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="6 9 12 15 18 9"/>
                        </svg>
                    </button>

                    <div class="mp-topbar-title">
                        <span class="mp-source">Geem Music</span>
                    </div>

                    <div class="mp-eq-indicator" id="mpEqIndicator" aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </div>
                </div>
            </div>

            <!-- Cover Album -->
            <div class="mp-stage">
                <div class="mp-cover-wrap">
                    <img
                        src="https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=700&q=80"
                        alt="Love me"
                        class="mp-cover"
                        id="mpCover"
                    >
                </div>
            </div>

            <!-- Bagian Bawah: Info, Progress, Kontrol, Up Next -->
            <div class="mp-deck">
                <div class="mp-meta-row">
                    <div class="mp-meta-text">
                        <h2 class="mp-title" id="mpTitle">Love me</h2>
                        <p class="mp-artist" id="mpArtist">Deveedaas Nandi</p>
                    </div>
                </div>

                <!-- Progress Scrubber -->
                <div class="mp-progress-wrap">
                    <div class="mp-progress-hit" id="mpProgressHit" role="slider" aria-label="Progres lagu" aria-valuemin="0" aria-valuemax="100" aria-valuenow="73">
                        <div class="mp-progress-track">
                            <div class="mp-progress-fill" id="mpProgressFill"></div>
                        </div>
                    </div>
                    <div class="mp-time-row">
                        <span id="mpCurrentTime">3:01</span>
                        <span id="mpDuration">4:12</span>
                    </div>
                </div>

                <!-- Transport Controls -->
                <div class="mp-controls">
                    <button type="button" class="mp-sub-btn" id="mpShuffleBtn" aria-label="Acak">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="16 3 21 3 21 8"/>
                            <line x1="4" y1="20" x2="21" y2="3"/>
                            <polyline points="21 16 21 21 16 21"/>
                            <line x1="15" y1="15" x2="21" y2="21"/>
                            <line x1="4" y1="4" x2="9" y2="9"/>
                        </svg>
                    </button>

                    <button type="button" class="mp-skip-btn" id="mpPrevBtn" aria-label="Lagu Sebelumnya">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                            <polygon points="11 5 1 12 11 19 11 5"/>
                            <polygon points="20 5 10 12 20 19 20 5"/>
                        </svg>
                    </button>

                    <button type="button" class="mp-play-btn" id="mpPlayBtn" aria-label="Putar">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                            <polygon points="7 4 21 12 7 20 7 4"/>
                        </svg>
                    </button>

                    <button type="button" class="mp-skip-btn" id="mpNextBtn" aria-label="Lagu Berikutnya">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                            <polygon points="4 5 14 12 4 19 4 5"/>
                            <polygon points="13 5 23 12 13 19 13 5"/>
                        </svg>
                    </button>

                    <button type="button" class="mp-sub-btn" id="mpRepeatBtn" aria-label="Ulangi">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="17 1 21 5 17 9"/>
                            <path d="M3 11V9a4 4 0 0 1 4-4h14"/>
                            <polyline points="7 23 3 19 7 15"/>
                            <path d="M21 13v2a4 4 0 0 1-4 4H3"/>
                        </svg>
                    </button>
                </div>

                <!-- Kartu Lagu Berikutnya -->
                <button type="button" class="mp-upnext" id="mpUpNextBtn" aria-label="Putar lagu berikutnya">
                    <img src="" alt="" class="mp-upnext-thumb" id="mpUpNextThumb">
                    <div class="mp-upnext-info">
                        <span class="mp-upnext-label">Berikutnya</span>
                        <span class="mp-upnext-title" id="mpUpNextTitle">Message — Cameron Rogers</span>
                    </div>
                    <svg class="mp-upnext-arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"/>
                    </svg>
                </button>
            </div>
        </div>
    </section>
</main>